# ---- copy to .env and fill in. NEVER commit .env ----

# API
SURF_API_HOST=127.0.0.1
SURF_API_PORT=8000
SURF_LOG_LEVEL=INFO
SURF_DATA_DIR=./data

# Browser origins allowed to call the API. The UI is a different origin from the API.
SURF_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Diagnostics: how many recent errors /diagnostics/errors retains in memory.
SURF_ERROR_BUFFER_SIZE=200

# LLM. Local first: a session is personal location history, and the local path never
# sends it anywhere. Ollama must be running.
SURF_LLM_ENABLED=false
SURF_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
SURF_LLM_HOST=http://127.0.0.1:11434
SURF_LLM_IDLE_TTL_SECONDS=600

# Hosted fallback, for a user with no local model. OPT-IN ONLY -- never selected
# automatically, because choosing it means sending session data off this machine.
SURF_LLM_REMOTE_ENABLED=false
SURF_LLM_REMOTE_URL=
SURF_LLM_REMOTE_MODEL=
SURF_LLM_REMOTE_API_KEY=

# Prose passes (Phase 11): deterministic, short, and budgeted.
SURF_LLM_TEMPERATURE=0
SURF_LLM_MAX_OUTPUT_TOKENS=100
SURF_LLM_MAX_REASONING_TOKENS=1000
SURF_LLM_CONTEXT_LIMIT_TOKENS=20000

# LLM eval gate: set to 1 to run the live-model evals (needs Ollama)
SURF_LLM_EVAL=0

# Basemap (free tier). Client-side, so it is public by design.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
